(version 1)
# Generated by hwde rules_gen.py from constraints + jlc_capabilities.
# Baseline (fab floor) first, per-net design rules last (later rule wins).
(rule "aiee_track_width_floor"
	(constraint track_width (min 0.1270mm))
	(condition "A.Type == 'track'")
)
(rule "aiee_clearance_floor"
	(constraint clearance (min 0.1270mm))
)
(rule "aiee_via_drill_floor"
	(constraint hole_size (min 0.3000mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_via_diameter_floor"
	(constraint via_diameter (min 0.6000mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_annular_floor"
	(constraint annular_width (min 0.1500mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_edge_clearance_floor"
	(constraint edge_clearance (min 0.3000mm))
)
(rule "aiee_hole_to_hole_floor"
	(constraint hole_to_hole (min 0.5000mm))
)
(rule "aiee_silk_width_floor"
	(constraint text_thickness (min 0.1500mm))
	(condition "A.Type == 'text' && (A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen')")
)
(rule "aiee_pwr_width_VBUS"
	(constraint track_width (min 0.2500mm))
	(condition "A.NetName == 'VBUS' && A.Type == 'track'")
)
(rule "aiee_pwr_width_VSYS"
	(constraint track_width (min 0.2500mm))
	(condition "A.NetName == 'VSYS' && A.Type == 'track'")
)
(rule "aiee_pwr_width_VBAT"
	(constraint track_width (min 0.2500mm))
	(condition "A.NetName == 'VBAT' && A.Type == 'track'")
)
(rule "aiee_pwr_width_3V3"
	(constraint track_width (min 0.2500mm))
	(condition "A.NetName == '+3V3' && A.Type == 'track'")
)
(rule "aiee_pwr_width_GND"
	(constraint track_width (min 0.3500mm))
	(condition "A.NetName == 'GND' && A.Type == 'track'")
)
(rule "aiee_diff_gap_USB"
	(constraint diff_pair_gap (min 0.3000mm))
	(condition "A.NetName == '/USB_DP' || A.NetName == '/USB_DM'")
)
(rule "aiee_diff_outer_only_USB"
	(layer inner)
	(constraint disallow track)
	(condition "A.NetName == '/USB_DP' || A.NetName == '/USB_DM'")
)
# Hand-added P5 (remediations/clearance.md, package geometry): USB-C 16P pads of J1 sit
# 0.15 mm apart (VBUS vs CC/SBU), above the 0.127 fab floor but under the 0.2 mm power-class
# clearance. Same-footprint pairs only. A rules_gen re-run DROPS this rule - re-append it.
(rule "aiee_samefp_J1_usbc"
	(constraint clearance (min 0.1270mm))
	(condition "A.memberOfFootprint('J1') && B.memberOfFootprint('J1')")
)
