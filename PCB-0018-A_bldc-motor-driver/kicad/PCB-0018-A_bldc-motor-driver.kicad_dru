(version 1)
# Generated by hwde rules_gen.py from constraints + jlc_capabilities.
# Baseline (fab floor) first, per-net design rules last (later rule wins).
(rule "aiee_track_width_floor"
	(constraint track_width (min 0.1524mm))
	(condition "A.Type == 'track'")
)
(rule "aiee_clearance_floor"
	(constraint clearance (min 0.1016mm))
)
(rule "aiee_via_drill_floor"
	(constraint hole_size (min 0.2000mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_via_diameter_floor"
	(constraint via_diameter (min 0.4500mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_annular_floor"
	(constraint annular_width (min 0.1000mm))
	(condition "A.Type == 'via'")
)
(rule "aiee_edge_clearance_floor"
	(constraint edge_clearance (min 0.3000mm))
)
(rule "aiee_hole_to_hole_floor"
	(constraint hole_to_hole (min 0.5000mm))
)
(rule "aiee_silk_width_floor"
	(constraint text_thickness (min 0.1500mm))
	(condition "A.Type == 'text' && (A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen')")
)
(rule "aiee_pwr_width_power_in_VM_IN"
	(constraint track_width (min 4.2566mm))
	(condition "A.NetName == '/power_in/VM_IN' && A.Type == 'track'")
)
(rule "aiee_pwr_width_VM"
	(constraint track_width (min 4.2566mm))
	(condition "A.NetName == 'VM' && A.Type == 'track'")
)
(rule "aiee_pwr_width_GND"
	(constraint track_width (min 4.2566mm))
	(condition "A.NetName == 'GND' && A.Type == 'track'")
)
(rule "aiee_pwr_width_PHASE_A"
	(constraint track_width (min 2.9666mm))
	(condition "A.NetName == '/PHASE_A' && A.Type == 'track'")
)
(rule "aiee_pwr_width_PHASE_B"
	(constraint track_width (min 2.9666mm))
	(condition "A.NetName == '/PHASE_B' && A.Type == 'track'")
)
(rule "aiee_pwr_width_PHASE_C"
	(constraint track_width (min 2.9666mm))
	(condition "A.NetName == '/PHASE_C' && A.Type == 'track'")
)
(rule "aiee_pwr_width_power_stage_LS_SRC_A"
	(constraint track_width (min 2.9666mm))
	(condition "A.NetName == '/power_stage/LS_SRC_A' && A.Type == 'track'")
)
(rule "aiee_pwr_width_power_stage_LS_SRC_B"
	(constraint track_width (min 2.9666mm))
	(condition "A.NetName == '/power_stage/LS_SRC_B' && A.Type == 'track'")
)
(rule "aiee_pwr_width_power_stage_LS_SRC_C"
	(constraint track_width (min 2.9666mm))
	(condition "A.NetName == '/power_stage/LS_SRC_C' && A.Type == 'track'")
)
(rule "aiee_pwr_width_5V"
	(constraint track_width (min 0.1625mm))
	(condition "A.NetName == '+5V' && A.Type == 'track'")
)
(rule "aiee_pwr_width_regulators_BUCK_SW"
	(constraint track_width (min 0.2250mm))
	(condition "A.NetName == '/regulators/BUCK_SW' && A.Type == 'track'")
)
(rule "aiee_pwr_width_12V"
	(constraint track_width (min 0.0250mm))
	(condition "A.NetName == '+12V' && A.Type == 'track'")
)
(rule "aiee_pwr_width_regulators_BOOST_SW"
	(constraint track_width (min 0.1000mm))
	(condition "A.NetName == '/regulators/BOOST_SW' && A.Type == 'track'")
)
(rule "aiee_pwr_width_3V3"
	(constraint track_width (min 0.0500mm))
	(condition "A.NetName == '+3V3' && A.Type == 'track'")
)
(rule "aiee_pwr_width_io_CTL_5V"
	(constraint track_width (min 0.0500mm))
	(condition "A.NetName == '/io/CTL_5V' && A.Type == 'track'")
)
(rule "aiee_pwr_width_io_SEN_5V"
	(constraint track_width (min 0.0500mm))
	(condition "A.NetName == '/io/SEN_5V' && A.Type == 'track'")
)
(rule "aiee_diff_gap_ISNS_A"
	(constraint diff_pair_gap (min 0.3000mm))
	(condition "A.NetName == '/ISNS_A_P' || A.NetName == '/ISNS_A_N'")
)
(rule "aiee_diff_outer_only_ISNS_A"
	(layer inner)
	(constraint disallow track)
	(condition "A.NetName == '/ISNS_A_P' || A.NetName == '/ISNS_A_N'")
)
(rule "aiee_diff_gap_ISNS_B"
	(constraint diff_pair_gap (min 0.3000mm))
	(condition "A.NetName == '/ISNS_B_P' || A.NetName == '/ISNS_B_N'")
)
(rule "aiee_diff_outer_only_ISNS_B"
	(layer inner)
	(constraint disallow track)
	(condition "A.NetName == '/ISNS_B_P' || A.NetName == '/ISNS_B_N'")
)
(rule "aiee_diff_gap_ISNS_C"
	(constraint diff_pair_gap (min 0.3000mm))
	(condition "A.NetName == '/ISNS_C_P' || A.NetName == '/ISNS_C_N'")
)
(rule "aiee_diff_outer_only_ISNS_C"
	(layer inner)
	(constraint disallow track)
	(condition "A.NetName == '/ISNS_C_P' || A.NetName == '/ISNS_C_N'")
)
(rule "aiee_hv_45v_PHASE_A"
	(constraint clearance (min 0.4000mm))
	(condition "A.NetName == '/PHASE_A'")
)
(rule "aiee_hv_45v_PHASE_B"
	(constraint clearance (min 0.4000mm))
	(condition "A.NetName == '/PHASE_B'")
)
(rule "aiee_hv_45v_PHASE_C"
	(constraint clearance (min 0.4000mm))
	(condition "A.NetName == '/PHASE_C'")
)
(rule "aiee_hv_45v_VM"
	(constraint clearance (min 0.4000mm))
	(condition "A.NetName == 'VM'")
)
(rule "aiee_hv_45v_power_in_VM_IN"
	(constraint clearance (min 0.4000mm))
	(condition "A.NetName == '/power_in/VM_IN'")
)
(rule "aiee_hv_45v_regulators_BUCK_SW"
	(constraint clearance (min 0.4000mm))
	(condition "A.NetName == '/regulators/BUCK_SW'")
)
(rule "aiee_hv_50v_regulators_BST5V"
	(constraint clearance (min 0.4000mm))
	(condition "A.NetName == '/regulators/BST5V'")
)
(rule "aiee_hv_57v_GHA"
	(constraint clearance (min 0.5000mm))
	(condition "A.NetName == '/GHA'")
)
(rule "aiee_hv_57v_GHB"
	(constraint clearance (min 0.5000mm))
	(condition "A.NetName == '/GHB'")
)
(rule "aiee_hv_57v_GHC"
	(constraint clearance (min 0.5000mm))
	(condition "A.NetName == '/GHC'")
)
(rule "aiee_hv_57v_gate_driver_BSTA"
	(constraint clearance (min 0.5000mm))
	(condition "A.NetName == '/gate_driver/BSTA'")
)
(rule "aiee_hv_57v_gate_driver_BSTB"
	(constraint clearance (min 0.5000mm))
	(condition "A.NetName == '/gate_driver/BSTB'")
)
(rule "aiee_hv_57v_gate_driver_BSTC"
	(constraint clearance (min 0.5000mm))
	(condition "A.NetName == '/gate_driver/BSTC'")
)

# HV clearance scope (owner answer, planning 2026-09-28). Hand-written, below the
# generated rules so it wins; re-add if rules_gen rewrites this file.
# (1) Same-phase nets of one leg sit within ~15 V of each other: normal clearance
#     (IPC-2221B B4, mask-coated external conductors, 0.13 mm up to 100 V).
(rule "hv_scope_same_phase_A"
	(constraint clearance (min 0.1300mm))
	(condition "(A.NetName == '/GHA' || A.NetName == '/gate_driver/BSTA' || A.NetName == '/PHASE_A' || A.NetName == '/GLA' || A.NetName == '/power_stage/LS_SRC_A' || A.NetName == '/power_stage/GATE_HA' || A.NetName == '/power_stage/GATE_LA') && (B.NetName == '/GHA' || B.NetName == '/gate_driver/BSTA' || B.NetName == '/PHASE_A' || B.NetName == '/GLA' || B.NetName == '/power_stage/LS_SRC_A' || B.NetName == '/power_stage/GATE_HA' || B.NetName == '/power_stage/GATE_LA')")
)
(rule "hv_scope_same_phase_B"
	(constraint clearance (min 0.1300mm))
	(condition "(A.NetName == '/GHB' || A.NetName == '/gate_driver/BSTB' || A.NetName == '/PHASE_B' || A.NetName == '/GLB' || A.NetName == '/power_stage/LS_SRC_B' || A.NetName == '/power_stage/GATE_HB' || A.NetName == '/power_stage/GATE_LB') && (B.NetName == '/GHB' || B.NetName == '/gate_driver/BSTB' || B.NetName == '/PHASE_B' || B.NetName == '/GLB' || B.NetName == '/power_stage/LS_SRC_B' || B.NetName == '/power_stage/GATE_HB' || B.NetName == '/power_stage/GATE_LB')")
)
(rule "hv_scope_same_phase_C"
	(constraint clearance (min 0.1300mm))
	(condition "(A.NetName == '/GHC' || A.NetName == '/gate_driver/BSTC' || A.NetName == '/PHASE_C' || A.NetName == '/GLC' || A.NetName == '/power_stage/LS_SRC_C' || A.NetName == '/power_stage/GATE_HC' || A.NetName == '/power_stage/GATE_LC') && (B.NetName == '/GHC' || B.NetName == '/gate_driver/BSTC' || B.NetName == '/PHASE_C' || B.NetName == '/GLC' || B.NetName == '/power_stage/LS_SRC_C' || B.NetName == '/power_stage/GATE_HC' || B.NetName == '/power_stage/GATE_LC')")
)
# (2) Inside the gate driver's (U301, DRV8300 WQFN-24, 0.5 mm pitch) courtyard, pad-to-pad
#     and pad-to-track drop to the package's own pitch, floor 0.13 mm (IPC-2221B A6,
#     external component leads, 31-100 V). The package is rated for these nets.
(rule "hv_scope_u301_courtyard"
	(constraint clearance (min 0.1300mm))
	(condition "A.intersectsCourtyard('U301') && B.intersectsCourtyard('U301')")
)
# (2b) Same for the VM_IN ideal-diode controller (U101, SOT-23-8, 0.65 mm pitch, 0.29 mm pad gap):
#      IPC-2221B A6, component leads up to 100 V; VM_IN is a <=60 V rail and U101 is rated for it.
(rule "hv_scope_u101_courtyard"
	(constraint clearance (min 0.1300mm))
	(condition "A.intersectsCourtyard('U101') && B.intersectsCourtyard('U101')")
)
# (3) Everywhere else the aiee_hv_* rules above keep 0.4/0.5 mm.

# Signal-current branches of the phase and low-side-source nets (snubber, sense divider, Kelvin):
# they carry no phase current, so the 2.97 mm power width does not apply inside their sig_branch_* rule areas.
(rule "sig_branch_PHASE_B"
	(constraint track_width (min 0.2000mm))
	(condition "A.NetName == '/PHASE_B' && A.Type == 'track' && A.enclosedByArea('sig_branch_PHASE_B')")
)
(rule "sig_branch_PHASE_C"
	(constraint track_width (min 0.2000mm))
	(condition "A.NetName == '/PHASE_C' && A.Type == 'track' && A.enclosedByArea('sig_branch_PHASE_C')")
)
(rule "sig_branch_PHASE_A"
	(constraint track_width (min 0.2000mm))
	(condition "A.NetName == '/PHASE_A' && A.Type == 'track' && A.enclosedByArea('sig_branch_PHASE_A')")
)
(rule "sig_branch_LS_SRC_C"
	(constraint track_width (min 0.2000mm))
	(condition "A.NetName == '/power_stage/LS_SRC_C' && A.Type == 'track' && A.enclosedByArea('sig_branch_LS_SRC_C')")
)
(rule "sig_branch_LS_SRC_A"
	(constraint track_width (min 0.2000mm))
	(condition "A.NetName == '/power_stage/LS_SRC_A' && A.Type == 'track' && A.enclosedByArea('sig_branch_LS_SRC_A')")
)
