  {
   "id": "limits",
   "title": "Operating range and protection",
   "steps": [
    {
     "id": "limits.01",
     "type": "supply",
     "role": "psu",
     "set": {
      "v": 10.0,
      "i_limit": 0.2,
      "output": true
     },
     "derived_from": "requirements VIN min 10 V"
    },
    {
     "id": "limits.02",
     "type": "wait",
     "seconds": 1.0
    },
    {
     "id": "limits.03",
     "type": "measure",
     "role": "psu",
     "quantity": "current",
     "expect": {
      "nominal": null,
      "min": 0.002,
      "max": 0.18,
      "unit": "A"
     },
     "derived_from": "idle current holds across the input range",
     "text": "idle current at 10 V"
    },
    {
     "id": "limits.04",
     "type": "supply",
     "role": "psu",
     "set": {
      "v": 28.0,
      "i_limit": 0.2,
      "output": true
     },
     "derived_from": "requirements VIN max 28 V"
    },
    {
     "id": "limits.05",
     "type": "wait",
     "seconds": 1.0
    },
    {
     "id": "limits.06",
     "type": "measure",
     "role": "psu",
     "quantity": "current",
     "expect": {
      "nominal": null,
      "min": 0.002,
