  {
   "id": "programming",
   "title": "Programming and first boot",
   "steps": [
    {
     "id": "programming.01",
     "type": "human",
     "text": "Connect the SWD probe to J601; the board stays powered from the supply."
    },
    {
     "id": "programming.02",
     "type": "flash",
     "role": "probe",
     "artifact": "elf",
     "derived_from": "manifest flash.commands, firmware 0.1.0+g6a564231"
    },
    {
     "id": "programming.03",
     "type": "human",
     "text": "Connect the USB-UART (3V3, 115200 8N1) to J701: adapter RX to pin 3 (board TX), adapter TX to pin 4 (board RX), GND to GND. Then press reset."
    },
    {
     "id": "programming.04",
     "type": "console",
     "role": "console",
     "send": null,
     "expect_re": "^fwe PCB-0018-A ",
     "timeout_s": 5,
     "derived_from": "manifest uart.banner_regex",
     "text": "boot banner"
    },
    {
     "id": "programming.05",
     "type": "console",
     "role": "console",
     "send": "version",
     "expect_re": "^OK ",
     "timeout_s": 2,
     "derived_from": "manifest commands[version]",
     "text": "firmware answers"
    }
   ]
  },
